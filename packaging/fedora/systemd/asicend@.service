[Unit]
Description=ASICEN PLEX userland daemon (%i)
Documentation=https://github.com/Khronos31/asicen-userland
After=local-fs.target systemd-udev.service
Before=pcscd.service
ConditionPathExists=/opt/asicen-userland/asicend
ConditionPathExists=/opt/asicen-userland/firmware/asicen-loader.bin

[Service]
Type=simple
User=asicend
Group=pcscd
SupplementaryGroups=video
# ASICEN has no USB serial. A root-owned instance file supplies one or two
# topology selectors plus --model (required when a loader image is supplied).
# Example: ASICEN_DEVICE_ARGUMENTS="--usb-path 1-2.1 --usb-path 1-2.2 --model w3u3"
EnvironmentFile=/etc/asicen-userland/%i.conf
ExecStart=/opt/asicen-userland/asicend $ASICEN_DEVICE_ARGUMENTS --instance %i --firmware /opt/asicen-userland/firmware/asicen-loader.bin --runtime-dir /run/asicen-userland --group
# Hardware absence and firmware errors require an explicit operator recovery;
# do not create an unbounded restart loop for a missing tuner.
Restart=no
RuntimeDirectory=asicen-userland
RuntimeDirectoryMode=0750
UMask=0007

# Keep the service read-only outside its systemd-created runtime hierarchy.
# Do not use PrivateDevices: libusb must access /dev/bus/usb.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/asicen-userland
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
