# SPDX-License-Identifier: GPL-2.0-only
# px4-userland pcsc-lite reader template. Replace all @...@ placeholders.
# On macOS, the LIBPATH value is the px4-userland-ifd.bundle directory,
# not its nested Contents/MacOS dylib.
# access=user is private to one account; access=group is for a pcscd service
# account sharing a group with px4d, which must then be started with --group.
# The DEVICENAME device= value is the 14-digit PX-Q3U4 base serial, or the 15-digit USB
# serial of a PX-MLT5PE/DTV02A-5TS-P (adjust FRIENDLYNAME for that model).
FRIENDLYNAME "PLEX PX-Q3U4 Internal Card Reader"
DEVICENAME   px4-userland:runtime=@PX4_RUNTIME_DIR@:device=@PX4_BASE_SERIAL@:access=@PX4_ACCESS@
LIBPATH      @PX4_IFD_LIBRARY@
CHANNELID    0
